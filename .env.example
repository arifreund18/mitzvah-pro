# URL do deploy do repo bar-beni (outro repositório). Só usado no rewrite /BarBeni/*
BAR_BENI_ORIGIN=http://localhost:3001

# Provedor de email: ses | resend (fallback). Auto: SES se AWS_* estiver definido.
EMAIL_PROVIDER=ses

# Amazon SES (us-east-2) — não commitar segredos
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Fallback enquanto mail.{slug}.mitzvah.pro não verifica (domínio apex já verificado no SES)
EMAIL_FROM_ADDRESS=convites@mitzvah.pro
# Relatórios DMARC (rua=) nos TXT _dmarc.mail.{slug}... — use um endereço real que você lê
DMARC_REPORT_EMAIL=dmarc@mitzvah.pro
# MAIL_FROM_LOCAL=convites
# MAIL_DOMAIN_PREFIX=mail
# Conta SES já em produção: defina true na Vercel (senão a fila fica em 1/s e 200/24h).
EMAIL_SES_PRODUCTION=true
# Teto por processo/evento em produção (default 2/s). Conta AWS pode ser ~14/s — não espelhar isso por evento.
# EMAIL_SES_EVENT_MAX_PER_SECOND=2
# EMAIL_SES_MIN_INTERVAL_MS=500


# Resend — só quando EMAIL_PROVIDER=resend (ou fallback se SES indisponível)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# DNS Vercel: site {slug}.mitzvah.pro + email mail.{slug}.mitzvah.pro (DKIM/SPF)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# VERCEL_DNS_DOMAIN=mitzvah.pro
MITZVAH_CONTACT_EMAIL=mitzvah@mitzvah.pro
MITZVAH_CONTACT_FORWARD_TO=arifreund@gmail.com

# Studio local (dashboard + wizard)
DASHBOARD_PASSWORD=mitzvah
DASHBOARD_SECRET=mitzvah-local-secret
# PLATFORM_OWNER_EMAIL=owner@mitzvah.pro
# PLATFORM_OWNER_PASSWORD=mitzvah

NEXT_PUBLIC_SITE_HOST=mitzvah.pro

# Persistência durável — OBRIGATÓRIA em produção Vercel.
# DATABASE_URL=postgres://...
# BLOB_READ_WRITE_TOKEN=   # obrigatório para uploads do studio (imagens públicas no Blob)
# PLATFORM_STORE_CACHE_TTL_MS=10000
# Leituras públicas por evento (Fase 3). Default ligado com Postgres; 0 desliga.
# PLATFORM_EVENT_SCOPED_READS=1
