# URL do deploy do repo bar-beni (outro repositório). Só usado no rewrite /BarBeni/*
BAR_BENI_ORIGIN=http://localhost:3001

RESEND_API_KEY=
# Domínio já verificado no Resend (fallback enquanto o domínio isolado do evento não verifica)
RESEND_FROM_EMAIL=

# Isolamento de email por evento (publish do wizard)
# Token Vercel: https://vercel.com/account/tokens  (o DNS do mitzvah.pro está na Vercel)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# VERCEL_DNS_DOMAIN=mitzvah.pro
# MAIL_FROM_LOCAL=convites
# MAIL_DOMAIN_PREFIX=mail
MITZVAH_CONTACT_EMAIL=mitzvah@mitzvah.pro
MITZVAH_CONTACT_FORWARD_TO=arifreund@gmail.com

# Studio local (dashboard + wizard)
DASHBOARD_PASSWORD=mitzvah
DASHBOARD_SECRET=mitzvah-local-secret

# Host canónico dos sites publicados: {slug}.mitzvah.pro
NEXT_PUBLIC_SITE_HOST=mitzvah.pro

# Persistência durável (produção Vercel). Sem isto, o JSON vai para /tmp e some.
# Preferência: DATABASE_URL (Postgres/Neon). Alternativa: Blob da Vercel.
# DATABASE_URL=postgres://...
# BLOB_READ_WRITE_TOKEN=
