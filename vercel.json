{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/follow-ups",
      "schedule": "15 12 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/mail-jobs",
      "schedule": "*/5 * * * *"
    }
  ]
}
